<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Empêche le trimming qui casse WPF -->
    <TrimUnusedDependencies>false</TrimUnusedDependencies>

    <!-- Build compact et autoportant -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <!-- Icône (optionnel si tu veux en ajouter une plus tard) -->
    <!-- <ApplicationIcon>Assets\SentroFPS.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
