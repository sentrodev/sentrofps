<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Empêche le trimming qui casse WPF -->
    <TrimUnusedDependencies>false</TrimUnusedDependencies>

    <!-- Build compact et autoportant -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <!-- Définit explicitement le point d'entrée -->
    <StartupObject>SentroFPS.Launcher.App</StartupObject>

    <!-- Supprime l'avertissement sur Microsoft.NET.Sdk.WindowsDesktop -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inclure tous les assets -->
    <Content Include="Assets\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
