<Window x:Class="SentroFPS.Launcher.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="SentroFPS" Height="540" Width="900" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
<Grid>
<!-- Fond dégradé animé -->
<Grid.Background>
<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
<GradientStop Color="#14161A" Offset="0"/>
<GradientStop Color="#1F2630" Offset="1"/>
</LinearGradientBrush>
</Grid.Background>


<Grid.Effect>
<DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#AA000000"/>
</Grid.Effect>


<!-- En‑tête draggable -->
<DockPanel Margin="16">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
<Image Source="Assets/logo.png" Width="42" Height="42" Margin="0,0,12,0"/>
<TextBlock Text="SentroFPS" FontSize="24" FontWeight="Bold" Foreground="#DFF2FF" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="_" Width="36" Height="28" Margin="8,0" Click="Minimize_Click"/>
<Button Content="✕" Width="36" Height="28" Click="Close_Click"/>
</StackPanel>
</StackPanel>
</DockPanel>


<!-- Corps -->
<Grid Margin="32,80,32,32">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="2*"/>
<ColumnDefinition Width="3*"/>
</Grid.ColumnDefinitions>


<!-- Panneau gauche: infos -->
<StackPanel>
<TextBlock x:Name="Announcement" Text="Chargement..." Foreground="#CFE6FF" FontSize="16"/>
<Border CornerRadius="12" Padding="16" Margin="0,16,0,0" Background="#202733">
<StackPanel>
<TextBlock Text="Options" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
<StackPanel Margin="0,8,0,0">
<CheckBox x:Name="ChkFps" Content="FPS Boost" Foreground="#E8F0FF" Margin="0,4"/>
<CheckBox x:Name="ChkPng" Content="PNG Mode" Foreground="#E8F0FF" Margin="0,4"/>
</StackPanel>
</StackPanel>
</Border>
</StackPanel>


<!-- Panneau droit: actions -->
<StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
    <StackPanel.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </StackPanel.Resources>
<Button x:Name="BtnUpdate" Content="Mettre à jour" Width="160" Height="44" Click="BtnUpdate_Click"/>
<Button x:Name="BtnPlay" Content="Jouer" Width="160" Height="44" Click="BtnPlay_Click"/>
</StackPanel>
</Grid>


<!-- Animation d'opacité à l'ouverture -->
<Window.Triggers>
<EventTrigger RoutedEvent="Window.Loaded">
<BeginStoryboard>
<Storyboard>
<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
</Storyboard>
</BeginStoryboard>
</EventTrigger>
</Window.Triggers>
</Grid>

</Window>
